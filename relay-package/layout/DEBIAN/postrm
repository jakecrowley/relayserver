#!/bin/sh
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if [ -x /var/jb/usr/bin/uicache ]; then
        /var/jb/usr/bin/uicache -u /var/jb/Applications/RelayServer.app >/dev/null 2>&1 || true
    else
        uicache -u /Applications/RelayServer.app >/dev/null 2>&1 || true
    fi
fi
exit 0
